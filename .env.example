# =============================================================================
# .env CONTOH UNTUK KOMPUTER SENDIRI (LOCAL)
# =============================================================================
# Cara pakai: salin jadi .env (Windows: copy .env.example .env), lalu
# php artisan key:generate dan isi nilai yang kosong di bawah.
# Untuk server production, lihat .env.production.example.
# =============================================================================

# ----- Aplikasi ---------------------------------------------------------------
APP_NAME=Mavnus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Harus sama persis dengan alamat yang kamu buka di browser (termasuk port).
# Foto produk memakai nilai ini. Kalau salah, foto tidak muncul.
# php artisan serve  -> http://127.0.0.1:8000
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ----- Log --------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----- Database (MySQL) -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mavnus_DB
DB_USERNAME=
DB_PASSWORD=

# ----- Ongkir (RajaOngkir / Komerce) ------------------------------------------
# Wajib diisi agar pencarian tujuan dan hitung ongkir di checkout berjalan.
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_ORIGIN_ID=26009

# ----- Pengaturan toko (semua opsional, ini nilai bawaannya) ------------------
ORDER_EXPIRE_MINUTES=60
ORDER_CLEANUP_THROTTLE_MINUTES=5
CART_RETENTION_DAYS=30
ORDER_EMAIL_ENABLED=false

# ----- Sesi, cache, antrean ---------------------------------------------------
# Jangan tambahkan SESSION_SECURE_COOKIE=true di local: alamat local memakai
# http, sehingga login tidak akan berfungsi. Pengaturan itu hanya untuk server.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ----- Email ------------------------------------------------------------------
# "log" = email tidak dikirim, hanya dicatat di storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
