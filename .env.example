# =============================================================================
# MAVNUS - CONTOH .env UNTUK PRODUCTION (DOKUMENTASI)
# =============================================================================
# Fungsi file ini: daftar lengkap pengaturan yang dibaca aplikasi di server,
# untuk dicocokkan dengan file .env di hosting (cPanel > File Manager).
#
# ATURAN PENTING
# 1. File ini TIDAK boleh berisi data rahasia asli. Semua nilai bertanda ISI_...
#    hanya contoh; isi nilai asli langsung di .env server, jangan di sini.
# 2. Deploy TIDAK menimpa .env di server. Perubahan .env baru terbaca setelah
#    deploy berikutnya (server menyimpan salinan pengaturan setiap deploy).
#    Setelah mengedit .env, jalankan ulang: GitHub > Actions > Run workflow.
# 3. Keterangan: [WAJIB] harus ada dan benar | [OPSIONAL] boleh dilewati
#    (ada nilai bawaan) | [JANGAN UBAH] sudah benar kalau sudah ada di server.
# =============================================================================


# ----- Aplikasi ---------------------------------------------------------------

# [OPSIONAL] Nama aplikasi (dipakai sebagai nama pengirim email bawaan).
APP_NAME=Mavnus

# [WAJIB] Harus production. Nilai "local" membuat aplikasi memakai mode
# pengembangan (misalnya header keamanan yang lebih longgar).
APP_ENV=production

# [JANGAN UBAH] Kunci enkripsi. Kalau di server sudah ada, JANGAN diganti:
# mengganti APP_KEY membuat semua pembeli dan tim ter-logout dan data
# terenkripsi tidak bisa dibaca. Jangan pernah tempel kunci asli di file ini.
APP_KEY=ISI_DARI_ENV_SERVER_JANGAN_DIGANTI

# [WAJIB] Harus false di production. Kalau true, halaman error menampilkan
# detail teknis (lokasi file, isi pengaturan) kepada siapa pun.
APP_DEBUG=false

# [WAJIB] Alamat situs lengkap, diawali https://. Kalau diawali https://,
# aplikasi otomatis memaksa semua link dan aset memakai https.
# Preview : https://preview.mavnus.com
# Utama   : https://mavnus.com   (ganti saat pindah domain)
APP_URL=https://preview.mavnus.com

# [OPSIONAL] Bahasa bawaan Laravel. Bahasa awal pengunjung toko diatur di
# config/mavnus.php (default_locale = id), jadi ini hanya cadangan.
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# [OPSIONAL] Mode perawatan (php artisan down) disimpan di file.
APP_MAINTENANCE_DRIVER=file

# [OPSIONAL] Tingkat pengamanan hash password. Kalau ada di server, biarkan.
BCRYPT_ROUNDS=12


# ----- Log (catatan error) ----------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# [DISARANKAN] "error" di production supaya file log tidak cepat membengkak.
# Pakai "debug" hanya sementara saat mencari masalah.
LOG_LEVEL=error


# ----- Database (MySQL di cPanel) ----------------------------------------------

# [WAJIB] Semua nilai di bawah dari cPanel > MySQL Databases.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ISI_NAMA_DATABASE
DB_USERNAME=ISI_USER_DATABASE
DB_PASSWORD=ISI_PASSWORD_DATABASE


# ----- Layanan ongkir (RajaOngkir / Komerce) -----------------------------------

# [WAJIB] Tanpa tiga nilai ini, pencarian tujuan dan hitung ongkir di checkout gagal.
RAJAONGKIR_API_KEY=ISI_API_KEY_RAJAONGKIR
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
# ID lokasi asal pengiriman toko.
RAJAONGKIR_ORIGIN_ID=26009


# ----- Pengaturan toko (dibaca lewat config/mavnus.php) -------------------------

# [OPSIONAL] Batas waktu (menit) pesanan "menunggu" sebelum otomatis dibatalkan
# (tampil sebagai "Kedaluwarsa"). Default 60. Selama Midtrans belum aktif,
# pertimbangkan menaikkannya agar staff punya waktu memproses pesanan.
ORDER_EXPIRE_MINUTES=60

# [OPSIONAL] Jeda minimal (menit) antar pemeriksaan pesanan kedaluwarsa. Default 5.
ORDER_CLEANUP_THROTTLE_MINUTES=5

# [OPSIONAL] Keranjang yang tidak disentuh sekian hari akan dibersihkan. Default 30.
CART_RETENTION_DAYS=30

# [OPSIONAL] true = kirim email konfirmasi ke pembeli setelah checkout.
# Default false. Ubah ke true HANYA setelah bagian MAIL_* di bawah terisi dan
# sudah diuji.
ORDER_EMAIL_ENABLED=false


# ----- Sesi, cache, dan antrean --------------------------------------------------

# Sesi login dan cache disimpan di database (tabelnya dibuat oleh migrasi).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# [WAJIB di production] Cookie login hanya dikirim lewat HTTPS. Aktifkan
# setelah situs benar-benar memakai https.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
# Email konfirmasi dikirim langsung (tanpa antrean), jadi tidak butuh worker.
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local


# ----- Email (SMTP) - hanya terpakai jika ORDER_EMAIL_ENABLED=true ---------------

# Selama email belum disiapkan, biarkan "log" (email hanya dicatat di file log,
# tidak terkirim). Untuk mengaktifkan, ganti ke smtp dan isi data dari
# cPanel > Email Accounts > Connect Devices.
MAIL_MAILER=log
MAIL_HOST=ISI_HOST_SMTP
# Port 465 = isi MAIL_SCHEME=smtps | Port 587 = kosongkan MAIL_SCHEME (null).
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=ISI_ALAMAT_EMAIL_PENGIRIM
MAIL_PASSWORD=ISI_PASSWORD_EMAIL
MAIL_FROM_ADDRESS="ISI_ALAMAT_EMAIL_PENGIRIM"
MAIL_FROM_NAME="${APP_NAME}"


# =============================================================================
# TIDAK PERLU ADA DI SERVER (boleh diabaikan atau dihapus kalau ada)
# =============================================================================
# - REDIS_*, MEMCACHED_*, AWS_*, VITE_APP_NAME : tidak dipakai aplikasi ini.
# - GOOGLE_* : login Google ditunda, tidak ada kode yang membacanya.
# - MIDTRANS_* : pembayaran Midtrans belum diaktifkan. Nanti ditambahkan
#   bersamaan dengan fitur pembayarannya.
